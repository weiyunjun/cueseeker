<Window
    x:Class="CueSeeker.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,*" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid Padding="12,8" ColumnDefinitions="*,Auto">
            <TextBlock Text="CueSeeker" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="BackendStatusText" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="310,*,380">
            <Border BorderThickness="0,1,1,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid RowDefinitions="Auto,*,Auto" Padding="12">
                    <TextBlock Text="Library" FontSize="20" FontWeight="SemiBold" Margin="4,4,0,12" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LibraryStack" Spacing="4">
                            <TextBlock
                                x:Name="LibraryEmptyText"
                                Text="Add folders in Settings, then run Index Now."
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Margin="4,8,4,0" />
                        </StackPanel>
                    </ScrollViewer>
                    <Button
                        x:Name="SettingsButton"
                        Grid.Row="2"
                        Margin="0,12,0,0"
                        Padding="14,10"
                        HorizontalAlignment="Stretch"
                        Click="SettingsButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE713;" FontSize="18" />
                            <TextBlock Text="Settings" FontSize="16" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="*,Auto" Padding="16">
                <Border
                    BorderThickness="1"
                    CornerRadius="8"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Background="Black">
                    <Grid>
                        <SwapChainPanel x:Name="PlaybackSurface" Loaded="PlaybackSurface_Loaded" />
                        <StackPanel x:Name="PlaybackOverlayPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <TextBlock
                                x:Name="PlaybackSurfaceStatusText"
                                HorizontalAlignment="Center"
                                Foreground="White"
                                Text="Native playback surface" />
                            <TextBlock
                                x:Name="PlaybackStatusText"
                                HorizontalAlignment="Center"
                                Foreground="#BFFFFFFF"
                                Text="Select a Library video or Search result." />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                    <Button x:Name="VideoFolderButton" Content="Video Folder" Click="VideoFolderButton_Click" IsEnabled="False" />
                    <Button x:Name="SubtitleFolderButton" Content="Subtitle Folder" Click="SubtitleFolderButton_Click" IsEnabled="False" />
                </StackPanel>
            </Grid>

            <Border Grid.Column="2" BorderThickness="1,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid RowDefinitions="Auto,*" Padding="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SearchModeButton" Click="SearchModeButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE721;" FontSize="14" />
                                <TextBlock Text="Search" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ShioriModeButton" Click="ShioriModeButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE734;" FontSize="14" />
                                <TextBlock Text="Shiori" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid x:Name="SearchPanel" Grid.Row="1" RowDefinitions="Auto,Auto,*" Margin="0,12,0,0">
                        <TextBox x:Name="SearchBox" PlaceholderText="Search subtitles..." TextChanged="SearchBox_TextChanged" />
                        <TextBlock
                            x:Name="SearchSummaryText"
                            Grid.Row="1"
                            Margin="0,10,0,8"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="No query." />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SearchResultsPanel" Spacing="6" />
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="ShioriPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock
                            Text="Shiori is not wired yet."
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
