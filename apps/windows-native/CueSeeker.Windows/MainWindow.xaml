<Window
    x:Class="CueSeeker.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid RowDefinitions="Auto,*">
        <Grid Padding="12" ColumnDefinitions="*,Auto">
            <TextBlock Text="CueSeeker Windows" VerticalAlignment="Center" FontSize="18" />
            <TextBlock x:Name="BackendStatusText" Grid.Column="1" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="280,*,320">
            <Border BorderThickness="0,1,1,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <ListView x:Name="DirectoryList" SelectionMode="Single" />
            </Border>

            <Grid Grid.Column="1" Background="Black">
                <SwapChainPanel x:Name="PlaybackSurface" Loaded="PlaybackSurface_Loaded" />
                <TextBlock
                    x:Name="PlaybackSurfaceStatusText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Text="Native playback surface" />
            </Grid>

            <Border Grid.Column="2" BorderThickness="1,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid RowDefinitions="Auto,*" Padding="12">
                    <TextBox x:Name="SearchBox" PlaceholderText="Search" />
                    <ListView x:Name="SearchResults" Grid.Row="1" Margin="0,12,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
